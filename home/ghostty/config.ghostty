# ~/.config/nix/home/ghostty/config.ghostty

#term = xterm-256color

# Font
font-family = JetBrainsMono Nerd Font
font-family = Sarasa Mono SC
font-size = 14
font-thicken = false

# Theme
# 可先用内置主题；可运行 ghostty +list-themes 查看
theme = 12-bit Rainbow
#theme = Atom

# Optional machine-local settings, such as a private background image.
config-file = ?~/.config/nix/.local/ghostty/config.ghostty

# Window
window-decoration = auto
window-padding-x = 8
window-padding-y = 8
window-theme = dark

# Transparency
background-opacity = 0.99
background-opacity-cells = true

# Cursor
cursor-style = block
cursor-style-blink = true
shell-integration-features = no-cursor

# Mouse
mouse-hide-while-typing = true

# Clipboard
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow

# Shell integration
shell-integration = zsh

# Confirm close
confirm-close-surface = false

# Keybinds
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+r=reload_config
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+enter=new_split:right
keybind = ctrl+shift+backslash=new_split:down
